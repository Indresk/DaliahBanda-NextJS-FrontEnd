{
	"name": "daliahbanda-next",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"db:create": "sequelize-cli db:create",
		"db:migrate": "sequelize-cli db:migrate",
		"db:seed": "sequelize-cli db:seed:all",
		"db:seed:undo": "sequelize-cli db:seed:undo:all",
		"db:migrate:undo": "sequelize-cli db:migrate:undo",
		"lint": "eslint",
		"db:build": "npm run db:create ; npm run db:migrate ; npm run db:seed; npm run build",
		"dev:db": "npm run db:create ; npm run db:migrate ; npm run db:seed ; next dev",
		"start:db": "npm run db:create ; npm run db:migrate && next start"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1152.0",
		"@aws-sdk/s3-request-presigner": "3.1152.0",
		"next": "^16.4.0",
		"next-auth": "5.0.0-beta.32",
		"pg": "^8.23.1",
		"pg-hstore": "^2.3.4",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"sequelize": "^6.37.8",
		"sequelize-cli": "^6.6.5",
		"server-only": "^0.0.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^20.19.43",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"dotenv": "^17.4.2",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.2.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3"
	}
}
